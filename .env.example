# Copy to .env and fill in locally. Never commit real credentials.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Jev access, option A: OpenRouter (one OpenRouter key, no TypeSafe account needed).
# Model ids: typesafe/jev-1.13 or ~typesafe/jev-latest
JEV_BASE_URL=https://openrouter.ai/api
JEV_MODEL=typesafe/jev-1.13
TYPESAFE_API_KEY=

# Jev access, option B: direct TypeSafe API (use in a supported region).
# JEV_BASE_URL=https://api.typesafe.ai
# JEV_MODEL=jev-latest
# TYPESAFE_API_KEY=

HOST=127.0.0.1
PORT=8000
LOCAL_BASE_URL=http://127.0.0.1:8000
# Optional authentication for the local service.
SERVICE_API_KEY=
REQUEST_TIMEOUT_MS=60000
MAX_RETRIES=2
